@page "/routines"

@using GymQuest.Models.Dtos
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column gap-3 align-content-center">
    <MudFab Class="position-fixed" Style="bottom: 24px; right: 24px; z-index: 1000;" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" Elevation="0" />
    <MudPaper Class="mud-theme-dark d-flex gap-2 align-items-center px-3 justify-content-center" Height="60px" Elevation="0">
            <MudText Typo="Typo.h4">Routines</MudText>
    </MudPaper>
    <MudDivider/>


    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }
    else if (routines is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (routines.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            Geen routines gevonden.
        </MudAlert>
    }
    else
    {
        @foreach (var routine in routines)
        {
            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h5">
                    @routine.Name
                </MudText>

                <MudText Typo="Typo.body2">
                    @routine.Description
                </MudText>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<RoutineDto>? routines;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            routines = await Http.GetFromJsonAsync<List<RoutineDto>>("api/routines");
        }
        catch (Exception ex)
        {
            errorMessage = ex.ToString();
        }
    }
}